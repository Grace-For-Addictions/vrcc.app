{
  "name": "UploadedDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "organizational_report",
        "needs_assessment",
        "past_grant",
        "financial_statement",
        "success_story",
        "other"
      ]
    },
    "file_url": {
      "type": "string",
      "description": "URL from UploadFile integration"
    },
    "extracted_content": {
      "type": "string",
      "description": "Key content extracted from document"
    },
    "key_statistics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "document_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}