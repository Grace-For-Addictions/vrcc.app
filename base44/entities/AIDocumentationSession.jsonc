{
  "name": "AIDocumentationSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Reference to original CoachingSessionLog ID"
    },
    "participant_email": {
      "type": "string"
    },
    "coach_email": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date-time"
    },
    "audio_transcript": {
      "type": "string",
      "description": "AI-generated transcript of session (HIPAA-compliant storage)"
    },
    "ai_generated_notes": {
      "type": "string",
      "description": "AI-generated progress notes (factual, objective)"
    },
    "coach_edited_notes": {
      "type": "string",
      "description": "Final notes after coach review/editing"
    },
    "ai_confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI confidence in generated content"
    },
    "session_insights": {
      "type": "object",
      "properties": {
        "talk_listen_ratio": {
          "type": "number",
          "description": "Coach talk time vs participant talk time"
        },
        "themes_identified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentiment_score": {
          "type": "number",
          "description": "Overall sentiment (-1 to 1)"
        },
        "action_items_detected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "time_saved_minutes": {
      "type": "number",
      "description": "Admin time saved by AI documentation"
    },
    "percent_ai_generated": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of final notes generated by AI"
    },
    "coach_review_time_minutes": {
      "type": "number",
      "description": "Time coach spent reviewing/editing AI notes"
    },
    "quality_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Coach rating of AI documentation quality"
    }
  },
  "required": [
    "session_id",
    "participant_email",
    "coach_email"
  ]
}