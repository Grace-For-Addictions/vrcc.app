{
  "name": "ResidentInvoice",
  "type": "object",
  "properties": {
    "resident_email": {
      "type": "string"
    },
    "house_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "processing"
      ],
      "default": "pending"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    },
    "payment_method": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    }
  },
  "required": [
    "resident_email",
    "house_id",
    "amount",
    "due_date"
  ]
}