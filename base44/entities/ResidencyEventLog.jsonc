{
  "name": "ResidencyEventLog",
  "type": "object",
  "properties": {
    "resident_email": {
      "type": "string"
    },
    "house_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "chore",
        "meeting",
        "check_in",
        "mood_log",
        "note"
      ]
    },
    "event_date": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "chore_data": {
      "type": "object",
      "properties": {
        "chore_name": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "photo_url": {
          "type": "string"
        },
        "verified_by": {
          "type": "string"
        }
      }
    },
    "meeting_data": {
      "type": "object",
      "properties": {
        "meeting_type": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "virtual_link": {
          "type": "string"
        }
      }
    },
    "check_in_data": {
      "type": "object",
      "properties": {
        "check_in_time": {
          "type": "string"
        },
        "check_out_time": {
          "type": "string"
        },
        "geofence_verified": {
          "type": "boolean"
        }
      }
    },
    "mood_data": {
      "type": "object",
      "properties": {
        "mood_score": {
          "type": "number"
        },
        "mood_emoji": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "blockchain_timestamp": {
      "type": "string",
      "description": "Immutable verification hash"
    },
    "synced_to_vrcc": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "resident_email",
    "house_id",
    "event_type",
    "title"
  ]
}