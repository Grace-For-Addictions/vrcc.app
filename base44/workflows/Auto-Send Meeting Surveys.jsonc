{
  "name": "Auto-Send Meeting Surveys",
  "description": "Automatically send social connectedness surveys after GFARC meetings",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "GFARCMeetingTracker"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_send_meeting_surveys",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoSendMeetingSurvey",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
